# Copy this file to .env.local and fill in real values, then load it into your shell
# before running the pipeline, e.g. in PowerShell:
#   Get-Content .env.local | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) } }
# Or just set each one directly: $env:OPENAI_API_KEY = "sk-..."

# https://platform.openai.com/api-keys — used for gpt-image-1 (reference + scene images)
OPENAI_API_KEY=

# https://console.anthropic.com/settings/keys — used for script writing and image-prompt generation
ANTHROPIC_API_KEY=

# https://elevenlabs.io/app/settings/api-keys — used for the voiceover
ELEVENLABS_API_KEY=

# Default narrator voice if the web UI's picker isn't used — a real voice ID from your
# ElevenLabs account (Voices tab) or the Voice Library. See config/voices.json for the
# curated picker list shown in the web UI.
ELEVENLABS_VOICE_ID=

# Optional overrides
CLAUDE_MODEL=claude-sonnet-5
FFMPEG_PATH=ffmpeg
# eleven_multilingual_v2 (default) or eleven_turbo_v2_5 for a faster/cheaper option
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Supabase (accounts + database) — Project Settings > API in your Supabase project ---
# Run supabase/schema.sql in the SQL Editor once before using any of this.
SUPABASE_URL=
# Safe to expose to the browser (served back via GET /api/public-config) — this is how
# every Supabase client-side app ships it. Never do this with the service role key below.
SUPABASE_ANON_KEY=
# Server-only — bypasses row-level security. Keep this out of any client-facing code.
SUPABASE_SERVICE_ROLE_KEY=

# --- PayPlus (subscription billing) — docs.payplus.co.il, values from your PayPlus dashboard ---
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_TERMINAL_UID=
# Created under Payment Pages in the PayPlus dashboard — the hosted checkout template used
# for every subscription signup.
PAYPLUS_PAYMENT_PAGE_UID=
PAYPLUS_CASHIER_UID=
# staging (default, restapidev.payplus.co.il) until verified — set to "production" to use
# restapi.payplus.co.il for real charges.
PAYPLUS_ENV=staging
